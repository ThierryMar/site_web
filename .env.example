# Copy to .env. Never commit secrets.
# Payload / Neon: use separate databases for development, preview and production.
PAYLOAD_SECRET=
DATABASE_URL=
# Optional direct Neon connection, used ONLY when running migrations.
DATABASE_URL_UNPOOLED=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Authentication emails: Resend API key and an address on a verified domain.
RESEND_API_KEY=
EMAIL_FROM=
# Optional Stripe integration. Start with test-mode keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional GA4. Loaded only after consent on the public frontend.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
